<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="t1" value="&lt;b&gt;BEV-EDLines 墙体提取算法框架&lt;/b&gt;" style="text;html=1;fontSize=16;fontColor=#1D3557;align=center;verticalAlign=middle;fontFamily=SimHei;" vertex="1" parent="1">
      <mxGeometry x="350" y="10" width="500" height="35" as="geometry"/>
    </mxCell>

    <!-- ─── Step 1: 输入点云 ─── -->
    <mxCell id="s1" value="输入点云" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=SimHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="30" y="80" width="80" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" source="s1" target="s2" parent="1"/>

    <!-- ─── Step 2: BEV 栅格化 ─── -->
    <mxCell id="s2" value="BEV 栅格化" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=SimHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="150" y="80" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s2_sub" value="① XY投影\n② 密度编码\n③ Log归一化\n④ 可选高斯模糊" style="text;html=1;fontSize=8;fontFamily=SimSun;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="155" y="125" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" source="s2" target="s3" parent="1"/>

    <!-- ─── Step 3: Sobel 梯度 ─── -->
    <mxCell id="s3" value="Sobel 梯度计算" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=SimHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="300" y="80" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s3_sub" value="① 3×3 Sobel算子\n② |gx|+|gy| 幅值\n③ 二进制方向 &amp;lt;br&amp;gt;   (|gx|≷|gy|)" style="text;html=1;fontSize=8;fontFamily=SimSun;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="305" y="125" width="100" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" source="s3" target="s4" parent="1"/>

    <!-- ─── Step 4: 锚点检测 NMS ─── -->
    <mxCell id="s4" value="锚点检测 (NMS)" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=SimHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="450" y="80" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s4_sub" value="沿梯度方向检查\n局部幅值极大值→锚点" style="text;html=1;fontSize=8;fontFamily=SimSun;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="455" y="125" width="100" height="40" as="geometry"/>
    </mxCell>
    <!-- Decision: gradient >= threshold? -->
    <mxCell id="d4" value="梯度幅值 &amp;gt;\nmag_threshold\n?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=SimHei;fontSize=9;html=1;" vertex="1" parent="1">
      <mxGeometry x="465" y="180" width="80" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="d4n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#6c8ebf;" edge="1" source="d4" target="s4" parent="1"/>
    <mxCell id="d4y" value="是→锚点" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=8;fontFamily=SimHei;fontColor=#82b366;" edge="1" parent="1">
      <mxGeometry x="0.5" y="0" relative="1" as="geometry">
        <mxPoint x="-5" as="offset"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="d4n2" value="否→跳过" style="text;html=1;fontSize=8;fontFamily=SimHei;fontColor=#e63946;align=center;" vertex="1" parent="1">
      <mxGeometry x="548" y="195" width="40" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" source="s4" target="s5" parent="1"/>

    <!-- ─── Step 5: 边缘绘制 ─── -->
    <mxCell id="s5" value="边缘绘制&lt;br&gt;(Edge Drawing)" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=SimHei;fontSize=10;html=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="80" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s5_sub" value="① 锚点按幅值降序\n② 双向链式追踪\n③ 3候选选最高梯度\n④ 方向一致性检查" style="text;html=1;fontSize=8;fontFamily=SimSun;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="605" y="125" width="100" height="60" as="geometry"/>
    </mxCell>
    <!-- Decision: chain len >= min? -->
    <mxCell id="d5" value="链长 ≥\nmin_chain_\nlen?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=SimHei;fontSize=9;html=1;" vertex="1" parent="1">
      <mxGeometry x="615" y="200" width="80" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="d5n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#6c8ebf;" edge="1" source="d5" target="s5" parent="1"/>
    <mxCell id="d5y" value="是→保留" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=8;fontFamily=SimHei;fontColor=#82b366;" edge="1" parent="1">
      <mxGeometry x="0.5" y="0" relative="1" as="geometry">
        <mxPoint x="-5" as="offset"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="d5n2" value="否→丢弃" style="text;html=1;fontSize=8;fontFamily=SimHei;fontColor=#e63946;align=center;" vertex="1" parent="1">
      <mxGeometry x="698" y="218" width="40" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" source="s5" target="s6" parent="1"/>

    <!-- ─── Step 6: 线段拟合 ─── -->
    <mxCell id="s6" value="线段拟合&amp;amp;\n曲率分裂" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=SimHei;fontSize=10;html=1;" vertex="1" parent="1">
      <mxGeometry x="750" y="80" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s6_sub" value="① PCA矩形拟合\n② 曲率递归分裂\n③ 拟合误差校验(RMS)" style="text;html=1;fontSize=8;fontFamily=SimSun;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="755" y="125" width="100" height="55" as="geometry"/>
    </mxCell>
    <!-- Decision: aspect ratio -->
    <mxCell id="d6" value="长宽比 ≥\nmin_length_\nratio?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=SimHei;fontSize=9;html=1;" vertex="1" parent="1">
      <mxGeometry x="765" y="195" width="80" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="d6n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#6c8ebf;" edge="1" source="d6" target="s6" parent="1"/>
    <mxCell id="d6y" value="是→保留" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=8;fontFamily=SimHei;fontColor=#82b366;" edge="1" parent="1">
      <mxGeometry x="0.5" y="0" relative="1" as="geometry">
        <mxPoint x="-5" as="offset"/>
      </mxGeometry>
    </mxCell>
    <mxCell id="d6n2" value="否→丢弃" style="text;html=1;fontSize=8;fontFamily=SimHei;fontColor=#e63946;align=center;" vertex="1" parent="1">
      <mxGeometry x="848" y="213" width="40" height="20" as="geometry"/>
    </mxCell>
    <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" source="s6" target="s7" parent="1"/>

    <!-- ─── Step 7: 墙壁验证 ─── -->
    <mxCell id="s7" value="墙壁验证&amp;amp;\n点分类" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=SimHei;fontSize=10;html=1;" vertex="1" parent="1">
      <mxGeometry x="900" y="80" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="s7_sub" value="① 3D点到直线距离\n② Z跨度校验(≥1.0m)\n③ 沿墙跨度校验(≥0.7m)\n④ 输出墙体点+平面" style="text;html=1;fontSize=8;fontFamily=SimSun;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="905" y="125" width="100" height="60" as="geometry"/>
    </mxCell>

    <!-- ─── Output ─── -->
    <mxCell id="s8" value="墙体点集 + 平面参数" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=SimHei;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1050" y="80" width="110" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" source="s7" target="s8" parent="1"/>

    <!-- ─── Parameter annotation box ─── -->
    <mxCell id="params" value="&lt;b&gt;关键参数：&lt;/b&gt;" style="text;html=1;fontSize=10;fontFamily=SimHei;fontColor=#1D3557;fillColor=#f0f4f8;strokeColor=#8BA8C4;rounded=1;verticalAlign=top;align=left;" vertex="1" parent="1">
      <mxGeometry x="30" y="270" width="1130" height="100" as="geometry"/>
    </mxCell>

    <!-- Parameter items -->
    <mxCell id="p1" value="&amp;bull; resolution=0.05m/像素  —  BEV栅格分辨率" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="50" y="285" width="240" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="p2" value="&amp;bull; distance=0.10m  —  点到直线匹配阈值" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="300" y="285" width="240" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="p3" value="&amp;bull; min_chain_len=15像素  —  边缘链最少长度" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="550" y="285" width="240" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="p4" value="&amp;bull; anchor_threshold=0.04  —  锚点检测阈值" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="800" y="285" width="240" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="p5" value="&amp;bull; grad_threshold=0.05  —  梯度幅值阈值" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="50" y="312" width="240" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="p6" value="&amp;bull; min_z_span=1.0m  —  墙面Z方向最小跨度" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="300" y="312" width="240" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="p7" value="&amp;bull; min_extent=0.7m  —  墙面沿墙方向最小跨度" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="550" y="312" width="240" height="22" as="geometry"/>
    </mxCell>
    <mxCell id="p8" value="&amp;bull; min_length_ratio=2.5  —  矩形最小长宽比" style="text;html=1;fontSize=9;fontFamily=SimSun;align=left;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="800" y="312" width="240" height="22" as="geometry"/>
    </mxCell>

    <!-- Annotation note -->
    <mxCell id="note" value="&lt;b&gt;注：&lt;/b&gt;与原始EDLines (Akinlar &amp;amp; Topal, 2011) 区别：① 使用 |gx|+|gy| 快速幅值替代勾股定理，避免开方运算；② 二进制方向 (|gx|≷|gy|) 替代 atan2/cos/sin 三角函数，提升计算速度；③ 新增高斯模糊预处理（可选）和拟合误差 RMS 校验。" style="text;html=1;fontSize=9;fontFamily=SimSun;fillColor=#fef9e7;strokeColor=#d4ac0d;rounded=1;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="30" y="380" width="1130" height="35" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
